# ================================================================
# Tally Connect — Environment Configuration Template
# Copy to .env.development, .env.staging, or .env.production
# ================================================================

# Environment Mode: 'development' | 'staging' | 'production'
NODE_ENV=development

# Server API Listening Port & Host
PORT=5001
HOST=0.0.0.0

# Public Domains & URLs
API_DOMAIN=api.tallyconnect.cloud
API_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173
AGENT_CLOUD_URL=http://localhost:5001

# MySQL Database (Primary Tenant & Cache Store)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=tally_connect

# Authentication & Security Secrets
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Rate Limiting (Per-Client Sliding Window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Local TallyPrime Configuration (Agent Defaults)
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
CONNECTOR_MODE=xml_http
MOCK_MODE=false
