# ================================================================
# Tally Connect - Environment Configuration Template
# Copy to .env.development, .env.staging, or .env.production
# ================================================================

# Environment Mode: 'development' | 'staging' | 'production'
NODE_ENV=development

# Server API Listening Port & Host
PORT=5001
HOST=0.0.0.0

# Base URLs
API_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173
AGENT_ENDPOINT=http://localhost:5001/api/connector

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=tally_connect
PGUSER=eunoia
PGPASSWORD=
PGSSL=false

# Local TallyPrime Configuration
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
CONNECTOR_MODE=mock
