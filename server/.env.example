# ==============================================================================
# Tally Connect — Development Environment Configuration Template
# ==============================================================================
NODE_ENV=development
MOCK_MODE=true
PORT=5001
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# API Domain & Agent Reachability
# ------------------------------------------------------------------------------
API_DOMAIN=localhost:5001
API_URL=http://localhost:5001
AGENT_CLOUD_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration (MySQL)
# Supports either a unified DATABASE_URL or discrete MYSQL_* credentials
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql://root:root@127.0.0.1:3306/tally_connect
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=tally_connect

# ------------------------------------------------------------------------------
# Security, JWT & Encryption Keys
# ------------------------------------------------------------------------------
API_MASTER_SECRET=tc_sec_dev_master_0123456789abcdef
JWT_SECRET=tc_jwt_dev_secret_99887766554433221100
ENCRYPTION_KEY=tc_enc_dev_key_0123456789abcdef0123456789abcdef
WEBHOOK_SIGNING_SECRET=tc_wh_dev_sec_a1b2c3d4e5f6

# ------------------------------------------------------------------------------
# Object Storage (local | s3 | gcs)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET=tally-connect-dev
STORAGE_LOCAL_DIR=./storage/exports
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ------------------------------------------------------------------------------
# API Protection & Queue Tuning
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
QUEUE_CONCURRENCY=5
QUEUE_POLL_INTERVAL_MS=3000
