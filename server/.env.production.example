# ==============================================================================
# Tally Connect — Production Environment Configuration Profile
# ==============================================================================
NODE_ENV=production
MOCK_MODE=false
PORT=5000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Production Domain & Reachability
# Replace with your actual fully qualified domain name (FQDN)
# ------------------------------------------------------------------------------
API_DOMAIN=api.tallyconnect.cloud
API_URL=https://api.tallyconnect.cloud
AGENT_CLOUD_URL=https://api.tallyconnect.cloud
CLIENT_URL=https://app.tallyconnect.cloud

# ------------------------------------------------------------------------------
# Production MySQL Database Configuration
# Option A: Unified DATABASE_URL (Recommended for AWS RDS, DigitalOcean, GCP Cloud SQL)
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql://tc_prod_user:StrongRandomPassword123!@db.internal:3306/tally_connect_prod?ssl={"rejectUnauthorized":true}

# Option B: Individual MySQL Connection Parameters
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tally_connect_user
MYSQL_PASSWORD=ChangeThisToAStrongProductionPassword123!
MYSQL_DATABASE=tally_connect_prod

# ------------------------------------------------------------------------------
# Security, JWT & Encryption Secrets (MUST be generated using crypto.randomBytes)
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_MASTER_SECRET=tc_sec_prod_replace_with_64_character_hex_string_here
JWT_SECRET=tc_jwt_prod_replace_with_64_character_hex_string_here
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WEBHOOK_SIGNING_SECRET=tc_wh_sign_prod_replace_with_32_character_hex_here

# ------------------------------------------------------------------------------
# Object Storage (AWS S3 or GCP Cloud Storage for large data exports)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=s3
STORAGE_BUCKET=tally-connect-production-exports
STORAGE_LOCAL_DIR=./storage/exports
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1

# ------------------------------------------------------------------------------
# Production API Protection & Concurrency
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
QUEUE_CONCURRENCY=10
QUEUE_POLL_INTERVAL_MS=2000
QUEUE_MAX_RETRIES=5
